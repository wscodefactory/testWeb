```gitignore
# dependencies
node_modules/

# production
dist/
build/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# cache
.cache/
.temp/
tmp/

# TypeScript
*.tsbuildinfo

# coverage
coverage/

# Vite
vite.config.ts.timestamp-*

# # generated docs
# docs/

# local database
*.sqlite
*.db

# package manager locks (선택)
# yarn.lock
# package-lock.json
# pnpm-lock.yaml
```

